# TechTalk Frontend Configuration
# Copy this file to .env.local to override the defaults (or set in your shell).

# URL of the TechTalk REST API backend (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Google OAuth (optional) - enables "Continue with Google"
# Same Client ID as backend GOOGLE_CLIENT_ID (type: Web application)
# Leave unset to keep the button as a "coming soon" placeholder
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com