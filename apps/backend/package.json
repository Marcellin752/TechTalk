{
  "name": "teachtalk-backend",
  "version": "0.1.0",
  "description": "REST API and content aggregation service for TechTalk",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "api",
    "scraper",
    "teachtalk"
  ],
  "author": "Flavio & Gloria & Marcellin & Obafemi",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.0",
    "fastify": "^5.8.5",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
