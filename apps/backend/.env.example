# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONFIGURATION
# Replace with your local PostgreSQL credentials
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# SECURITY & AUTHENTICATION
# Put a random long string here to secure JWT tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# CORS CONFIGURATION
# In production this must be the real, exact origin of the site (no trailing slash).
FRONTEND_URL=http://localhost:5173
# Public address used in the sitemap and social previews (defaults to FRONTEND_URL)
# SITE_URL=https://your-site.example

# FIRST ADMINISTRATOR (optional) - created/updated by `npm run db:seed`
# In production the password needs 12+ characters with lower case, upper case and a digit.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# GOOGLE OAUTH (optional) - used by "Continue with Google"
# Create OAuth Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# AUTOMATION & THIRD-PARTY APIS
# Your Google Cloud Console YouTube Data API v3 Key
YOUTUBE_API_KEY=AIzaSyANp_6DM-EO5O0r10qKXavXbseJ6mhZIgM

# YouTube provider configuration (optional)
# Comma-separated list of YouTube channel IDs to monitor (UC... format)
# YOUTUBE_CHANNELS=UC_x5XG1OV2P6uZZ5FSM9Ttw
# Comma-separated list of keywords to search for latest tech videos
# YOUTUBE_KEYWORDS=programming,web development,typescript,AI technology
# Maximum results fetched per keyword or per channel (1-50, default: 10)
# YOUTUBE_MAX_RESULTS=10

# Reddit API (optional) - create an app at https://www.reddit.com/prefs/apps
# (type: "script"). Required to bypass Reddit's cloud IP blocking via OAuth2.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# GITHUB OAUTH (optional) - used by "Continue with GitHub"
# Callback URL to register on GitHub: http://localhost:5001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GITHUB CONTENT PROVIDER (optional tuning; GITHUB_TOKEN is required to enable it)
# GITHUB_TOKEN=            # classic token, no scope needed
# GITHUB_TOPICS=typescript,javascript,react,python,rust,go,ai,machine-learning,devops
# GITHUB_MIN_STARS=100
# GITHUB_MAX_PER_TOPIC=10

# KAIROS (AI assistant) - all optional, server-side only: never put these keys in the frontend.
# Get a key at https://aistudio.google.com/apikey (Gemini) and https://console.groq.com/keys (Groq).
# LLM_PROVIDER=groq              # groq | gemini (the other one is the fallback)
# GEMINI_API_KEY=
# GEMINI_MODEL=                  # pick a "flash" model from the list your key returns (see README of the setup)
# GROQ_API_KEY=
# GROQ_MODEL=                    # pick one from GET https://api.groq.com/openai/v1/models

# KAIROS_DAILY_LIMIT=120         # messages per user per day
# LLM_TIMEOUT_MS=25000
