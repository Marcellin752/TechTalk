# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONFIGURATION
# Replace with your local PostgreSQL credentials
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# SECURITY & AUTHENTICATION
# Put a random long string here to secure JWT tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# CORS CONFIGURATION
FRONTEND_URL=http://localhost:5173

# GOOGLE OAUTH (optional) - used by "Continue with Google"
# Create OAuth Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# AUTOMATION & THIRD-PARTY APIS
# Your Google Cloud Console YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube provider configuration (optional)
# Comma-separated list of YouTube channel IDs to monitor (UC... format)
# YOUTUBE_CHANNELS=UC_x5XG1OV2P6uZZ5FSM9Ttw
# Comma-separated list of keywords to search for latest tech videos
# YOUTUBE_KEYWORDS=programming,web development,typescript,AI technology
# Maximum results fetched per keyword or per channel (1-50, default: 10)
# YOUTUBE_MAX_RESULTS=10

# YouTube provider configuration (optional)
# Comma-separated list of YouTube channel IDs to monitor (UC... format)
# YOUTUBE_CHANNELS=UC_x5XG1OV2P6uZZ5FSM9Ttw
# Comma-separated list of keywords to search for latest tech videos
# YOUTUBE_KEYWORDS=programming,web development,typescript,AI technology
# Maximum results fetched per keyword or per channel (1-50, default: 10)
# YOUTUBE_MAX_RESULTS=10

# Reddit API (optional) - create an app at https://www.reddit.com/prefs/apps
# (type: "script"). Required to bypass Reddit's cloud IP blocking via OAuth2.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
