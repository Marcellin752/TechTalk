# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONFIGURATION
# Replace with your local PostgreSQL credentials
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# SECURITY & AUTHENTICATION
# Put a random long string here to secure JWT tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# CORS CONFIGURATION
FRONTEND_URL=http://localhost:5173

# AUTOMATION & THIRD-PARTY APIS
# Your Google Cloud Console YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit API (optional) - create an app at https://www.reddit.com/prefs/apps
# (type: "script"). Required to bypass Reddit's cloud IP blocking via OAuth2.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
